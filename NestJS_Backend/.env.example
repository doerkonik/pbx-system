# ============================================================================
#  PBX Backend Environment  (VM2: 10.23.88.125)
#  Copy to .env and fill in real values. No secret is ever hardcoded in source.
# ============================================================================

# ---- App -------------------------------------------------------------------
NODE_ENV=development
APP_PORT=3001
APP_HOST=0.0.0.0
# Comma-separated list of allowed browser origins (Next.js frontend)
CORS_ORIGINS=http://10.23.88.125:3000,http://localhost:3000
LOG_LEVEL=info

# ---- PostgreSQL (VM2) ------------------------------------------------------
DB_HOST=10.23.88.125
DB_PORT=5432
DB_USERNAME=pbx
DB_PASSWORD=change_me_pg
DB_NAME=pbx
# Set to true ONLY for first local bring-up; production must use migrations.
DB_SYNCHRONIZE=false
DB_LOGGING=false
DB_SSL=false

# ---- Redis (VM2) -----------------------------------------------------------
REDIS_HOST=10.23.88.125
REDIS_PORT=6379
REDIS_PASSWORD=change_me_redis
REDIS_DB=0
REDIS_KEY_PREFIX=pbx:

# ---- JWT -------------------------------------------------------------------
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars_long
JWT_ACCESS_TTL=900s
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars_long
JWT_REFRESH_TTL=7d

# ---- Rate limiting (auth endpoints) ----------------------------------------
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=10
AUTH_THROTTLE_LIMIT=5

# ---- Asterisk AMI (VM1) ----------------------------------------------------
AMI_HOST=10.23.88.124
AMI_PORT=5038
AMI_USERNAME=pbx-ami
AMI_PASSWORD=change_me_ami
AMI_RECONNECT_BASE_MS=1000
AMI_RECONNECT_MAX_MS=30000

# ---- Asterisk ARI (VM1) ----------------------------------------------------
ARI_URL=http://10.23.88.124:8088
ARI_USERNAME=pbx-ari
ARI_PASSWORD=change_me_ari
ARI_APP_NAME=pbx
ARI_RECONNECT_BASE_MS=1000
ARI_RECONNECT_MAX_MS=30000

# ---- Recording -------------------------------------------------------------
# Path on VM1 where Asterisk writes MixMonitor files (must be reachable for
# playback: either an NFS/SSHFS mount on VM2 or served by an Asterisk HTTP dir).
RECORDING_DIR=/var/spool/asterisk/monitor
RECORDING_FORMAT=wav
# Retention in days; nightly job archives/prunes older files.
RECORDING_RETENTION_DAYS=90
RECORDING_ARCHIVE_DIR=/var/spool/asterisk/monitor/archive

# ---- Telephony behaviour ---------------------------------------------------
# Default MoH class assigned to new queues when none specified.
DEFAULT_MOH_CLASS=default
# Parking lot context/extension exposed to the dashboard.
PARKING_LOT=default
# Stasis app name calls are handed to for ARI control (matches ARI_APP_NAME).
STASIS_APP=pbx
