# ---------------------------------------------------------------------------
# PBX Frontend environment variables
# Copy this file to `.env.local` and adjust values for your deployment.
# Only NEXT_PUBLIC_* variables are exposed to the browser. Never put secrets
# here beyond public endpoints.
# ---------------------------------------------------------------------------

# REST API base URL (backend). All lib/api.ts requests are prefixed with this.
NEXT_PUBLIC_API_BASE_URL=http://10.23.88.125:3001/api

# Realtime websocket (socket.io) endpoint for telephony events.
NEXT_PUBLIC_WS_URL=http://10.23.88.125:3001/realtime

# SIP over secure websocket (WSS) URL used by the softphone (built later).
# IMPORTANT: this SIP WSS host must be DIRECTLY reachable from the agent's
# browser. It is VM1 (the media/SIP server), NOT the backend API host.
NEXT_PUBLIC_SIP_WSS_URL=wss://10.23.88.124:8089/ws

# SIP domain / realm used when registering the softphone.
# Same VM1 host as the WSS URL above (not the backend).
NEXT_PUBLIC_SIP_DOMAIN=10.23.88.124
